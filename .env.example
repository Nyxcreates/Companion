# ─────────────────────────────────────────────────────────────────────────────
# Companion — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file with real credentials to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Firebase Client (public — safe for browser) ───────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only — NEVER expose, NEVER use NEXT_PUBLIC_) ───────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the values directly — do NOT reference the JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project-id>.iam.gserviceaccount.com
# Paste the private_key value from the JSON exactly, keeping the \n newline escapes
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Gemini API (server only — NEVER expose) ───────────────────────────────────
# Get this from Google AI Studio → API Keys
GEMINI_API_KEY=

# ── Web Push / VAPID (server & client — Phase 3) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:companion@app.internal

# ─────────────────────────────────────────────────────────────────────────────
# Vercel setup:
# Add all of the above in Vercel Dashboard → Project → Settings → Environment Variables
# Do NOT add variables via the Vercel CLI — it's easier to miss some.
# ─────────────────────────────────────────────────────────────────────────────

